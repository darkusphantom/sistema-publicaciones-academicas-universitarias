# Red FaCyT — variables de entorno
# Copia este archivo a .env.local y completa los valores reales.
# NUNCA subas secretos reales al repositorio.
#
# Un solo despliegue (Vercel): la web y la API (Hono montado como Route Handler)
# comparten app y variables. La API lee estas claves vía `process.env`.

# URL base de la aplicación (enlaces absolutos y metadatos).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── API (auth + rate limit) ───────────────────────────────────────────────────
# Origen(es) permitidos por CORS (CSV). En Vercel: la URL del proyecto.
CORS_ORIGINS=http://localhost:3000
# Secreto de firma de sesiones (>= 32 bytes). Genera: openssl rand -base64 32
BETTER_AUTH_SECRET=
# URL pública de la app para Better Auth (mismo dominio del deploy).
BETTER_AUTH_URL=http://localhost:3000
# Rate limiting de auth (login/registro).
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# ── Supabase (PostgreSQL gestionado) — SOLO backend, nunca al cliente ─────────
# El frontend nunca habla con Supabase: toda la BD pasa por la API.
# En serverless usa la cadena del pooler en modo TRANSACCIÓN (puerto 6543).
# Formato: postgresql://postgres.<ref>:<PASSWORD>@aws-<region>.pooler.supabase.com:6543/postgres
# Sin DATABASE_URL la API usa el store en memoria (solo demo/desarrollo).
DATABASE_URL=
SUPABASE_URL=

# ── Trello (MCP / automatización) — SIN valores reales, solo claves ───────────
# Genéralas en https://trello.com/apps/admin → Power-Up → Trello Auth.
# El token se obtiene en https://trello.com/1/authorize?expiration=never&scope=read&response_type=token&key=<API_KEY>
TRELLO_API_KEY=
TRELLO_API_SECRET=
TRELLO_API_TOKEN=