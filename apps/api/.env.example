# Red FaCyT API — variables de entorno
# Copia este archivo a .env y completa los valores reales.
# NUNCA subas secretos reales al repositorio.

# Entorno de ejecución: development | production | test.
NODE_ENV=development

# Puerto HTTP de la API (el web vive en 3000; la API en 3001).
PORT=3001

# Interfaz de escucha del servidor.
HOST=0.0.0.0

# Whitelist estricta de orígenes CORS (CSV), sin reflejo de Origin.
# Requerida en production; no hay defaults silenciosos para ella.
CORS_ORIGINS=http://localhost:3000

# Límite global del cuerpo de petición en bytes (100 KB por defecto).
MAX_BODY_BYTES=102400

# Nivel de log para pino: trace | debug | info | warn | error | fatal | silent.
LOG_LEVEL=info

# ── Claves futuras reservadas (llegan con auth y base de datos) ─────────────
# Cadena de conexión a PostgreSQL.
# DATABASE_URL=
# Secreto de firma de sesiones de Better Auth.
# BETTER_AUTH_SECRET=
# URL pública de la API para Better Auth.
# BETTER_AUTH_URL=
# Rate limiting (requisito P0 cuando llegue auth).
# RATE_LIMIT_MAX=
# RATE_LIMIT_WINDOW_MS=