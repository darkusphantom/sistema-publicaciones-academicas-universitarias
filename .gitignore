# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── Secretos: NUNCA al repo (el repositorio es PÚBLICO) ───────────────────────
# Variables de entorno reales (.env, .env.local, .env.production, .env.* …).
# Solo se versiona `.env.example` con placeholders, sin valores reales.
.env*
!.env.example
# Otros archivos que suelen contener secretos.
.envrc
*.key
*.p12
*.pfx
*.keystore
# Configs locales de herramientas MCP que pueden llevar claves de API.
.mcp.json
.cursor/mcp.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# husky
.husky/_

# dev
chrome/